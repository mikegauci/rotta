NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WooCommerce read-only REST API key (only needed for migration)
WC_URL=https://rotta.mt
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Resend (transactional email). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Rotta <noreply@rotta.mt>
# Where contact form and new-listing notifications go
EMAIL_ADMIN_TO=

# Supabase secret key (server only): public event submissions, Stripe webhook
# and the migration import. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Stripe hosted Checkout (server only; Mike supplies these values).
# Production uses Rotta's live key; local/Preview use a test key (sk_test_).
# Test-mode orders are marked livemode=false and can be purged from the admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Register /api/stripe/webhook/ for checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded.
# No publishable key is needed for the hosted Checkout redirect.

# Keep false until payment recovery and acceptance testing are complete.
SHOP_CHECKOUT_ENABLED=false

# Any long random string; Vercel Cron sends it to /api/cron/checkouts/ and /api/cron/heartbeat/.
CRON_SECRET=
